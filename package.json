{
  "name": "jambu",
  "version": "0.0.0",
  "private": true,
  "description": "A little digital companion that looks out for you while you work.",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "build": "tsc --build",
    "check:readme": "node scripts/check-readme-distinct.mjs",
    "verify": "eslint . && tsc --build --force && vitest run && tsc --build && node scripts/check-readme-distinct.mjs && prettier --check .",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
