# Jambu environment configuration
# Copy to .env and fill in. NEVER commit .env (CLAUDE.md §31).

# ---------------------------------------------------------------------------
# Supabase (D2)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Anon key. Used SERVER-SIDE ONLY, by apps/api, to proxy Supabase Auth.
# It is never shipped in the extension bundle.
SUPABASE_ANON_KEY=

# Service-role key. SERVER-SIDE ONLY. Bypasses RLS.
# Never expose to the extension, never log, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the migration runner.
DATABASE_URL=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3000
API_HOST=127.0.0.1
NODE_ENV=development

# Comma-separated allowed origins for CORS (CLAUDE.md §31, decision D19).
# Explicit origins only — "*" is rejected at startup. The Chrome extension
# origin (chrome-extension://<extension-id>) is added here once the extension
# id exists in P8; it is deliberately not hard-coded.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Requests per minute per IP on the auth routes. Defaults to 10.
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Extension
# ---------------------------------------------------------------------------
# Base URL the extension calls. The extension holds NO Supabase keys.
VITE_JAMBU_API_BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Observability (optional — CLAUDE.md §6)
# ---------------------------------------------------------------------------
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
